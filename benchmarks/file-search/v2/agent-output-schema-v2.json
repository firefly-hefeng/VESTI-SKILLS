{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VESTI file-location response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "answerable": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_session_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "historical_only": {
            "type": "boolean",
            "description": "Set true when the path is supported by captured history but has not been independently verified in the current filesystem; set false only after such verification."
          }
        },
        "required": [
          "path",
          "project",
          "evidence_session_ids",
          "historical_only"
        ]
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "explanation": {
      "type": "string"
    }
  },
  "required": [
    "answerable",
    "files",
    "confidence",
    "explanation"
  ]
}
