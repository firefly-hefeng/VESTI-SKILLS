{
  "name": "@vesti/mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes VESTI's captured conversation memory (session recall, timeline, project context, memory space, file index) to agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vesti-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:standalone": "node scripts/smoke-standalone.mjs",
    "prepack": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/firefly-hefeng/VESTI-SKILLS.git",
    "directory": "packages/vesti-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vesti/capture-runtime": "workspace:*",
    "@vesti/search-files-core": "workspace:*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.2.0"
  }
}
