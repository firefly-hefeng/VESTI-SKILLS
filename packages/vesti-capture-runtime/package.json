{
  "name": "@vesti/capture-runtime",
  "version": "0.1.0",
  "description": "Headless VESTI capture engine, single-writer daemon and lightweight IPC client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vesti-captured": "./dist/daemon-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./injected-blocks": {
      "types": "./dist/injectedBlocks.d.ts",
      "import": "./dist/injectedBlocks.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/firefly-hefeng/VESTI-SKILLS.git",
    "directory": "packages/vesti-capture-runtime"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chokidar": "^3.6.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
